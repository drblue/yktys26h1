{
	"name": "08-node-prisma-books",
	"version": "1.0.0",
	"description": "An Express app with TypeScript, Prisma and SQLite",
	"scripts": {
		"build": "tsc",
		"check": "tsc --noEmit",
		"lint": "oxlint --type-aware --deny-warnings src",
		"quality": "npm run lint && npm run check && npm run type-coverage && npm run build",
		"dev": "tsx --watch src/index.ts",
		"start": "node dist/index.js",
		"db:setup": "prisma generate && tsx prisma/prepare-db.ts && prisma migrate deploy && prisma db seed",
		"type-coverage": "type-coverage --project tsconfig.json --detail --at-least 99"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"type": "module",
	"dependencies": {
		"cors": "^2.8.6",
		"express": "^5.3.0",
		"@prisma/adapter-better-sqlite3": "7.8.0",
		"@prisma/client": "7.8.0",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"private": true,
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^24.19.2",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"oxlint": "1.94.0",
		"oxlint-tsgolint": "7.0.2007",
		"prisma": "^7.8.0",
		"type-coverage": "2.31.2",
		"vite": "8.3.5"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"fsevents@2.3.3": true,
		"@prisma/client@7.8.0": true,
		"better-sqlite3@12.11.1": true,
		"@prisma/engines@7.10.1": true,
		"prisma@7.10.1": true
	},
	"overrides": {
		"type-coverage-core": {
			"typescript": "npm:@typescript/typescript6@6.0.2",
			"minimatch": "11.0.1"
		}
	},
	"typeCoverage": {
		"ignoreFiles": [
			"src/generated/**"
		]
	}
}
