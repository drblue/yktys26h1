{
	"name": "08-node-prisma-books",
	"version": "1.0.0",
	"description": "An Express app with TypeScript, Prisma and SQLite",
	"scripts": {
		"build": "tsc",
		"check": "tsc --noEmit",
		"dev": "tsx --watch src/index.ts",
		"start": "node dist/index.js",
		"db:setup": "prisma generate && prisma migrate deploy && prisma db seed"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"type": "module",
	"dependencies": {
		"cors": "^2.8.6",
		"express": "^5.3.0",
		"@prisma/adapter-better-sqlite3": "7.8.0",
		"@prisma/client": "7.8.0",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"private": true,
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^24.19.2",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"prisma": "^7.8.0",
		"vite": "8.3.5"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"fsevents@2.3.3": true,
		"@prisma/client@7.8.0": true,
		"better-sqlite3@12.11.1": true,
		"@prisma/engines@7.10.1": true,
		"prisma@7.10.1": true
	}
}
