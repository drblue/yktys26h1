{
  "name": "06-react-todos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc -b",
    "test": "node --test test/*.test.ts",
    "lint": "oxlint --type-aware --deny-warnings src",
    "quality": "npm run lint && npm run check && npm run type-coverage",
    "type-coverage": "type-coverage --project tsconfig.app.json --detail --at-least 99",
    "preview": "vite preview",
    "server": "json-server --watch data/db.json --port 3000 --delay 2000"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "react": "^19.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bootstrap": "^5.3.8",
    "json-server": "^0.17.4",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "sass": "1.77.6",
    "type-coverage": "2.31.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "overrides": {
    "type-coverage-core": {
      "typescript": "npm:@typescript/typescript6@6.0.2",
      "minimatch": "11.0.1"
    }
  }
}
